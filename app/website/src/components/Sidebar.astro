---
import ChevronRight from '@/assets/icons/chevron-right.svg';
import { packageList, pkgHref, type Package } from '@/lib/packages';

import PackageSelector from "@/components/navigation/PackageSelection.astro"

interface Props {
	pkg: Package;
}

const { pkg } = Astro.props;

const tabs = [
	// Home only matches its own path; the others also match the pages beneath them
	{ label: 'Home', href: pkgHref(pkg), exact: true },
	{ label: 'Docs', href: pkgHref(pkg, 'docs'), exact: false },
	{ label: 'Playground', href: pkgHref(pkg, 'playground'), exact: false },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string, exact: boolean) => (exact ? current === href : current === href || current.startsWith(`${href}/`));

/** The same section in another package. Doc pages differ between packages, so they land on the docs index */
const section = current.split('/')[2];
const switchHref = (other: Package) => pkgHref(other, section ?? '');
---

<style>
	
nav[data-sidebar-component="nav-wrapper"]:hover li[data-sidebar-component="nav-item"] a[aria-current='page'] {

	/* border: 1px solid blue; */
	background-color: color-mix(in oklab, var(--color-neutral-900) 80%, transparent);
}

nav[data-sidebar-component="nav-wrapper"] li[data-sidebar-component="nav-item"]:not(:has([aria-current='page'])):hover {

	background-color: color-mix(in oklab, var(--color-neutral-900) 10%, transparent);
}

nav[data-sidebar-component="nav-wrapper"] ul {
	position: relative;
}

nav[data-sidebar-component="nav-wrapper"]:not(:has(a:hover, a:focus-visible))
  a[aria-current="page"],
nav[data-sidebar-component="nav-wrapper"] a:is(:hover, :focus-visible) {
  anchor-name: --target;
}

li[data-sidebar-component="nav-item"] {
	position: relative;
	z-index: 1;
	border-radius: var(--radius-md);
}

li[] {
	background-color: color-mix(in oklab, var(--color-neutral-900) 80%, transparent);
}

.highlight {
  position: absolute;
  position-anchor: --target;

  left: anchor(left);
  top: anchor(top);
  width: anchor-size(width);
  height: anchor-size(height);

  /* background: #e5e5e5; */
  background: color-mix(in oklab, var(--color-neutral-900) 10%, transparent);
  border-radius: var(--radius-md);
  pointer-events: none;

  transition:
    left 250ms ease,
    top 250ms ease,
    width 250ms ease,
    height 250ms ease;
}

@media (prefers-reduced-motion: reduce) {
  .highlight {
    transition: none;
  }
}

/* The package switcher opens below its trigger; without anchor positioning it sits top left */
.package-trigger {
	anchor-name: --package-trigger;
}

.package-menu {
	position-anchor: --package-trigger;
	top: calc(anchor(bottom) + var(--spacing));
	left: anchor(left);
	min-width: anchor-size(width);
}

@supports not (anchor-name: --a) {
	.package-menu {
		top: 4rem;
		left: 1rem;
	}
}

.package-chevron {
	transform: rotate(90deg);
	transition: transform 150ms ease;
}

.package-trigger:has(+ .package-menu:popover-open) .package-chevron {
	transform: rotate(-90deg);
}

@media (prefers-reduced-motion: reduce) {
	.package-chevron {
		transition: none;
	}
}

</style>

<aside transition:persist={`sidebar-${pkg.id}`} class="border-b border-neutral-200 bg-neutral-50 p-4 md:w-56 md:shrink-0 md:border-r md:border-b-0">
	<PackageSelector />
	<div class="mb-4">
		<button
			type="button"
			popovertarget="package-switcher"
			aria-haspopup="true"
			aria-label={`${pkg.name}: switch package`}
			class="package-trigger flex w-full items-center justify-between gap-2 rounded-md px-3 py-1 text-left text-lg font-semibold transition-colors duration-150 hover:bg-neutral-900/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
		>
			<span class="truncate">{pkg.name}</span>
			<ChevronRight class="package-chevron size-4 shrink-0 text-neutral-500" aria-hidden="true" />
		</button>
		<div id="package-switcher" popover class="package-menu m-0 min-w-48 rounded-md border border-neutral-200 bg-white p-1 text-neutral-900 shadow-sm">
			<ul class="flex flex-col gap-0.5">
				{packageList.map((other) => (
					<li>
						<a
							href={switchHref(other)}
							data-package-link={other.id}
							aria-current={other.id === pkg.id ? 'true' : undefined}
							class="flex items-center justify-between gap-3 rounded-md px-3 py-2 text-sm text-neutral-600 hover:bg-neutral-900/10 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-neutral-900 aria-[current=true]:font-medium aria-[current=true]:text-neutral-900"
						>
							{other.name}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
	<nav data-sidebar-component="nav-wrapper">
		<ul class="flex gap-1 md:flex-col">
			{tabs.map(({ label, href, exact }) => (
				<li data-sidebar-component="nav-item">
					<a
						href={href}
						aria-current={isCurrent(href, exact) ? 'page' : undefined}
						data-exact={exact ? '' : undefined}
						data-astro-prefetch="load"
						class="block rounded-md px-3 py-2 text-sm text-neutral-600 aria-[current=page]:bg-neutral-900 aria-[current=page]:text-white"
					>
						{label}
					</a>
				</li>
			))}
			<span class="highlight" aria-hidden="true"></span>
		</ul>
	</nav>
</aside>

<script>
	// The sidebar persists between pages of the same package, so its links are refreshed on
	// every navigation. A package switch swaps in that package's sidebar, so nothing is cached.
	document.addEventListener('astro:page-load', () => {
		const path = location.pathname.replace(/\/$/, '') || '/';

		document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-component="nav-item"] a').forEach((link) => {
			const href = link.pathname.replace(/\/$/, '');
			const match = 'exact' in link.dataset ? path === href : path === href || path.startsWith(`${href}/`);
			if (match) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});

		// Switching package keeps the current section (home, docs or playground)
		const section = path.split('/')[2];
		document.querySelectorAll<HTMLAnchorElement>('[data-package-link]').forEach((link) => {
			link.href = `/${link.dataset.packageLink}${section ? `/${section}` : ''}`;
		});

		document.querySelector<HTMLElement>('#package-switcher:popover-open')?.hidePopover();
	});
</script>
