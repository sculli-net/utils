---

import { cn } from "@/lib/utils";
import { cva, type VariantProps } from "cva"

const tabsListVariants = cva(
    {
      base: "group/tabs-list inline-flex w-fit items-center justify-center rounded-lg p-[3px] text-muted-foreground group-data-horizontal/tabs:h-8 group-data-vertical/tabs:h-fit group-data-vertical/tabs:flex-col data-[variant=line]:rounded-none",
    variants: {
      variant: {
        default: "bg-muted",
        line: "gap-1 bg-transparent",
      },
    },
    defaultVariants: {
      variant: "default",
    },
  }
)

interface Props {
    variant?: VariantProps<typeof tabsListVariants>["variant"];
    ariaLabel?: string;
    class?: string;
}

const { class: className, ariaLabel, variant = "default" } = Astro.props;
---

<div data-slot="tabs-list" role="tablist" data-variant={variant} aria-label={ariaLabel} class={cn(tabsListVariants({ variant }), className)}>
    <slot />
</div>