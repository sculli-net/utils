---
import { DropdownMenu, DropdownTrigger, DropdownContent, DropdownItem } from '@/components/ui/dropdown';
import { packageList, pkgHref, type Package } from '@/lib/packages';
interface Props { pkg?: Package; }
const { pkg } = Astro.props;
const section = Astro.url.pathname.split('/')[2];
---
<DropdownMenu defaultValue={pkg?.id ?? 'root'}>
  <DropdownTrigger>{pkg?.name ?? 'sculli/utils'}</DropdownTrigger>
  <DropdownContent>
    <DropdownItem value="root" href="/" current={!pkg}>sculli/utils</DropdownItem>
    <div class="separator"></div>
    {packageList.map(other => <DropdownItem value={other.id} href={pkgHref(other, section ?? '')} packageId={other.id} current={other.id === pkg?.id}>{other.name}</DropdownItem>)}
  </DropdownContent>
</DropdownMenu>
<style>.separator { height: 1px; background: var(--border); margin: 5px 7px; }</style>
