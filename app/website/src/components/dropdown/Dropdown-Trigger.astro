---
import { appender, cn } from "@/lib/utils";
import ChevronDown from "@/assets/icons/chevron-down.svg"

interface Props {
    menuId?: string;
    className?: string;
    displayIcon?: boolean;
}

const { menuId, className, displayIcon = true } = Astro.props;

const withMenuId = appender(menuId);

---

<button
    class={cn(
        "inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none",
        "focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-[3px] aria-invalid:ring-destructive/20",
        "dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40",
        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
        "border-border bg-input/30 hover:bg-input/50 hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground",
        "h-9 gap-1.5 px-3 has-data-[icon=inline-end]:pr-2.5 has-data-[icon=inline-start]:pl-2.5", className)}
    id={withMenuId`menu-trigger`}
    popovertarget={withMenuId`menu`}
    data-slot="dropdown-trigger"
    data-dropdown-trigger={menuId}
    style={`anchor-name: var(--menu--anchor);`}
>
    <slot />
    {displayIcon ? <slot name="icon">
        <ChevronDown />
    </slot> : null }
</button>

<style define:vars={{ menuid: withMenuId`--menu-btn` }}>
    button {
        /* anchor-name: var(--menu-anchor); */
    }
</style>

<script>

    const initaliseMenuButton = () => {
        const menu = document.getElementById('menu');
        const menuBtn = document.getElementById('menu-btn');
        if (!menu || !menuBtn) return;
    }


    // menu.addEventListener('click', (e) => {
    //     const item = e.target?.closest('button');
    //     if (!item) return;
    //     output.textContent = `Picked: ${item.textContent}`;
    //     menu.hidePopover();
    // });

    // // Fallback for browsers without CSS anchor positioning
    // if (!CSS.supports('anchor-name: --a')) {
    //     menu.addEventListener('beforetoggle', (e) => {
    //     if (e.newState !== 'open') return;
    //     const r = menuBtn.getBoundingClientRect();
    //     menu.style.top = `${r.bottom}px`;
    //     menu.style.left = `${r.left}px`;
    //     });
    // }

    initaliseMenuButton();

</script>