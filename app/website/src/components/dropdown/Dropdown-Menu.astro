---

import { nanoid } from "nanoid";
import { appender, cn } from "@/lib/utils";

const menuId = nanoid(8);

const anchor = `--menu-${menuId}`;

const { defaultValue } = Astro.props;

// const withMenuId = appender(menuId);

---

<dropdown-menu data-menuid={menuId} style={`--menu-${menuId}-anchor: ${anchor}`} defaultvalue={defaultValue}>
    <slot />
</dropdown-menu>

<style define:vars={{ menuanchor: `--menu-${menuId}-anchor` }}>

    [data-menuid] {
        --menu-anchor: var(--menuanchor);
    }

</style>

<script>
    // Define the behavior for our new type of HTML element.
    class DropdownMenu extends HTMLElement {
      connectedCallback() {

        // placeholder
        
        const menuId = this.dataset.menuid;
        // if (menuId) {
        //     this.querySelectorAll('*').forEach((el)=>{
        //         el.setAttribute('data-menuid', menuId)
        //     });
        // }

        let value = this.getAttribute('defaultvalue');

        
        const menuTrigger = this.querySelector(`[data-slot="dropdown-trigger"]`);
        const menuContent = this.querySelector(`[data-slot="dropdown-content"]`);
        const menuItems = this.querySelectorAll(`[data-slot="dropdown-item"]`);

        
  
        if (menuTrigger instanceof HTMLElement && menuContent instanceof HTMLElement && menuItems.entries().every(([_, el]) => el instanceof HTMLElement)) {
            // console.log("mounted")

            const updateValues = (selectionValue: string | null) => {
                value = selectionValue;
                selectionValue ? this.setAttribute('value', selectionValue) : this.removeAttribute('value');
                menuItems.forEach(item=>{
                    const itemValue = item.getAttribute("value");
                    if (value && itemValue === value) {
                        // console.log("selected", value)
                        item.setAttribute("aria-current", "true");
                    } else {
                        item.setAttribute("aria-current", "false");
                    }
                })
            }

            const selectAction = (selectionValue: string | null) => {
                updateValues(selectionValue);
                this.dispatchEvent(
                    new CustomEvent(`dropdown:select`, {
                        detail: { value: selectionValue, menuId },
                        bubbles: true,
                    })
                );
                
                // console.log(selectionValue)
            }
            menuContent.addEventListener('click', (e: Event) => {
                if (!(e.target instanceof Element)) return;
                const item = e.target?.closest('button');
                if (!item || !menuContent.contains(item)) return;
                // const value = item.dataset.itemValue; // string | undefined
                const value = item.getAttribute('value'); // string | undefined
                if (!value) return;
                selectAction(value)
                menuContent.hidePopover();
            });
            updateValues(value);
        }

        
      }

      /**
       * Add this when working with ClientRouter, otherwise connectedCallback is used on each page nav.
       * when this is method is added; connectedMoveCallback is called each time the element is moved on the dom instead of connectedCallback
       * 
       */
      connectedMoveCallback() {
        // console.log("connectedMoveCallback() called on DropdownMenu")


      }
      adoptedCallback() {
        console.log("adoptedCallback() called on DropdownMenu")
      }

      attributeChangedCallback(name: string, oldValue: string, newValue: string) {
        console.log(`DropdownMen attribute: ${name}, changed from '${oldValue}' to ${newValue}`)
      }
    }
  
    customElements.define("dropdown-menu", DropdownMenu);
</script>