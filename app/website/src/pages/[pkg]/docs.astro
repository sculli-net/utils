---
import Layout from '@/layouts/Layout.astro';
import DocsNavigation from '@/components/navigation/DocsNavigation.astro';
import { packagePaths, type Package } from '@/lib/packages';

export const getStaticPaths = packagePaths;

const { pkg } = Astro.props as { pkg: Package };
---

<Layout title="Docs" pkg={pkg}>
	<h1 class="mb-4 text-3xl font-bold">Docs</h1>
	<p class="text-neutral-600">Placeholder: documentation for {pkg.name} will go here.</p>
	<DocsNavigation pkg={pkg} />
</Layout>
