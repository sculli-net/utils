---
import Layout from '@/layouts/Layout.astro';
import { bannerMetrics, packagePaths, packageList, pkgHref, type Package } from '@/lib/packages';


export const getStaticPaths = packagePaths;


const { pkg: pkgId } = Astro.params;

const { pkg } = Astro.props as { pkg: Package };
---

<Layout title={`Not Found | ${pkg.name}`} pkg={pkg}>
    <p>Docs of {pkg.name} is not found!!</p>
</Layout>

