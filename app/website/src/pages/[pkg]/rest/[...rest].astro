---
import Layout from '@/layouts/Layout.astro';
import { bannerMetrics, packagePaths, packageList, pkgHref, type Package } from '@/lib/packages';

// used for 404 pages -
// to enable an actual catch-all route here we would need to opt this into server-rendering with
// `export const prerender = false;`

/**
 * UPDATE: This still doesn't work ... 
 * The Astro framework seems to have a limitation to be able to render a catch-all fallback route param without using server rendering.
 * Ideally we do
 */

export const getStaticPaths = () => packageList.map((pkg) => ({ params: { pkg: pkg.id, rest: undefined }, props: { pkg } }));

// const { pkg: pkgId } = Astro.params;

const { pkg } = Astro.props as { pkg: Package };


---

<Layout title={`Not Found | ${pkg.name}`}>
    {pkg.name} is not found!!
</Layout>

